{
  "name": "max-web-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Веб-чат для мессенджера MAX через GREEN-API",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
